{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.example.com"
        }
      ],
      "destination": "https://example.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.example.com"
        }
      ],
      "destination": "https://example.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "de"
        }
      ],
      "destination": "/de",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "es"
        }
      ],
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/fr",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "it"
        }
      ],
      "destination": "/it",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "ar"
        }
      ],
      "destination": "/ar",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "ja"
        }
      ],
      "destination": "/ja",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "zh"
        }
      ],
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^en.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^de.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/de",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^es.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/fr",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^it.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/it",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ar.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/ar",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ja.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/ja",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^zh.*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^(?!(pl|en|de|es|fr|it|ar|ja|zh)([-,;]|$))[a-zA-Z].*$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|facebookexternalhit|[Pp]review|Lighthouse|HeadlessChrome).*"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/o-mnie",
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/:lang(en|de|es|fr|it|ar|ja|zh)/about",
      "destination": "/:lang/contact",
      "permanent": true
    },
    {
      "source": "/wystapienia",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(en|de|es|fr|it|ar|ja|zh)/talks",
      "destination": "/:lang",
      "permanent": true
    },
    {
      "source": "/projekty",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(en|de|es|fr|it|ar|ja|zh)/projects",
      "destination": "/:lang",
      "permanent": true
    }
  ]
}
