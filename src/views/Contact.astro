---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { type Lang, routeAlternates, t } from '@/i18n';
import { profile, publicSocials } from '@/data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const lead = tr('contact.lead');
// The template ships a TODO placeholder; hide WhatsApp until it's filled in.
const hasWhatsapp = !profile.whatsapp.url.includes('TODO');
---

<Base lang={lang} title={`${tr('nav.contact')} — ${profile.name}`} description={lead} alternates={routeAlternates('contact')}>
  <PageHeader eyebrow={tr('nav.contact')} title={tr('cta.contact')} lead={lead} />
  <section class="container-page">
    {
      hasWhatsapp && (
        <div class="border-t border-line pt-8">
          <p class="eyebrow">WhatsApp</p>
          <a href={profile.whatsapp.url} rel="noopener" target="_blank" class="display mt-3 inline-block text-3xl hover:text-accent sm:text-5xl" dir="ltr">
            {profile.whatsapp.label} ↗
          </a>
        </div>
      )
    }
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      <li>
        <a href={`mailto:${profile.email}`} class="card block hover:border-accent">
          <p class="eyebrow">Email</p>
          <p class="mt-3 break-all text-sm text-muted" dir="ltr">{profile.email}</p>
        </a>
      </li>
      {
        publicSocials.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank" class="card block hover:border-accent">
              <p class="eyebrow">{s.name}</p>
              <p class="mt-3 break-all text-sm text-muted" dir="ltr">
                {s.url.replace('https://', '')} ↗
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
