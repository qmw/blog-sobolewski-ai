---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { type Lang, routeAlternates, t } from '@/i18n';
import { profile, publicSocials } from '@/data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const lead = tr('contact.lead');
---

<Base lang={lang} title={`${tr('nav.contact')} — ${profile.name}`} description={lead} alternates={routeAlternates('contact')}>
  <PageHeader eyebrow={tr('nav.contact')} title={tr('cta.contact')} lead={lead} />
  <section class="container-page">
    <div class="border-t border-line pt-8">
      <p class="eyebrow">Email</p>
      <a href={`mailto:${profile.email}`} class="display mt-3 inline-block break-all text-3xl hover:text-accent sm:text-5xl" dir="ltr">
        {profile.email}
      </a>
    </div>
    {
      publicSocials.length > 0 && (
        <ul class="mt-10 grid gap-4 sm:grid-cols-2">
          {publicSocials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank" class="card block hover:border-accent">
                <p class="eyebrow">{s.name}</p>
                <p class="mt-3 break-all text-sm text-muted" dir="ltr">
                  {s.url.replace('https://', '')} ↗
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
