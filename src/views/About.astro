---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { type Lang, route, routeAlternates, t, pick } from '@/i18n';
import { profile, publicSocials } from '@/data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const title = `${tr('nav.about')} — ${profile.name}`;
---

<Base lang={lang} title={title} description={pick(profile.intro, lang)} alternates={routeAlternates('about')}>
  <PageHeader eyebrow={tr('nav.about')} title={pick(profile.headline, lang)} lead={pick(profile.intro, lang)} />
  <section class="container-page flex flex-wrap items-center gap-4">
    <a href={route('contact', lang)} class="btn btn-primary">{tr('cta.contact')} →</a>
    {
      publicSocials.map((s) => (
        <a href={s.url} rel="me noopener" target="_blank" class="btn btn-ghost">
          {s.name} ↗
        </a>
      ))
    }
  </section>
</Base>
