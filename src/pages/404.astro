---
import Base from '@/layouts/Base.astro';
import { route, t } from '@/i18n';
const tr = t('pl');
const en = t('en');
---

<Base lang="pl" title={tr('404.title')} description={tr('404.body')} alternates={{}} noindex>
  <section class="container-page py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="display mt-4 text-5xl sm:text-7xl">{tr('404.title')}</h1>
    <p class="mt-5 text-lg text-muted">{tr('404.body')}</p>
    <p class="mt-2 text-sm text-muted" lang="en">{en('404.title')}. {en('404.body')}</p>
    <div class="mt-10 flex justify-center gap-3">
      <a href={route('home', 'pl')} class="btn btn-primary">{tr('nav.home')}</a>
      <a href={route('home', 'en')} class="btn btn-ghost" lang="en">{en('nav.home')} (EN)</a>
    </div>
  </section>
</Base>
