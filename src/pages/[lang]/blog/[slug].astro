---
import View from '@/views/BlogPost.astro';
import { prefixedLangs } from '@/i18n';
import { getPosts, parseId, type Post } from '@/lib/blog';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of prefixedLangs) {
    for (const post of await getPosts(lang)) {
      paths.push({ params: { lang, slug: parseId(post.id).slug }, props: { post } });
    }
  }
  return paths;
}
const { post } = Astro.props as { post: Post };
---

<View post={post} />
