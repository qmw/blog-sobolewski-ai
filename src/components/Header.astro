---
import { type Lang, route, navOrder, t, languages, langs } from '@/i18n';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const tr = t(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== route('home', lang) && (path === href || path.startsWith(href + '/'));
const links = navOrder.map((key) => ({ href: route(key, lang), label: tr(`nav.${key}`) }));
// Languages without this page (e.g. an untranslated post) link to that language's home page.
const switcher = langs.map((l) => ({ lang: l, name: languages[l].name, href: alternates[l] ?? route('home', l) }));
---

<header class="sticky top-0 z-40 border-t-2 border-t-accent border-b border-b-line/70 bg-bg/85 backdrop-blur">
  <nav class="container-page flex h-14 items-center justify-between gap-4" aria-label="Main">
    <a href={route('home', lang)} class="font-mono text-sm font-semibold tracking-tight" aria-label={tr('nav.home')} dir="ltr">
      example<span class="text-accent">.com</span>
    </a>

    <ul class="hidden items-center gap-7 text-sm md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={['transition-colors hover:text-fg', isActive(l.href) ? 'text-fg underline decoration-accent decoration-2 underline-offset-[0.55rem]' : 'text-muted']}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <details class="relative">
        <summary
          class="list-none flex cursor-pointer items-center gap-1.5 rounded-full border border-line px-3 py-1.5 font-mono text-xs uppercase text-muted hover:border-accent hover:text-accent [&::-webkit-details-marker]:hidden"
          aria-label={tr('nav.language')}
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path>
          </svg>
          {lang}
        </summary>
        <ul class="card absolute end-0 mt-2 w-44 space-y-0.5 !p-2 text-sm shadow-xl">
          {
            switcher.map((s) => (
              <li>
                <a
                  href={s.href}
                  hreflang={languages[s.lang].hreflang}
                  lang={languages[s.lang].hreflang}
                  dir={languages[s.lang].dir}
                  class:list={['block rounded-lg px-3 py-1.5 hover:bg-accent-soft hover:text-accent', s.lang === lang && 'text-accent']}
                  aria-current={s.lang === lang ? 'true' : undefined}
                >
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-full border border-line p-2 text-muted hover:border-accent hover:text-accent"
        aria-label={tr('theme.toggle')}
      >
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <details class="relative md:hidden">
        <summary
          class="list-none cursor-pointer rounded-full border border-line p-2 text-muted hover:border-accent hover:text-accent [&::-webkit-details-marker]:hidden"
          aria-label={tr('nav.menu')}
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="card absolute end-0 mt-2 w-48 space-y-1 !p-2 text-sm shadow-xl">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class:list={['block rounded-lg px-3 py-2 hover:bg-accent-soft hover:text-accent', isActive(l.href) && 'text-accent']}
                  aria-current={isActive(l.href) ? 'page' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
  // Remember an explicit language choice (any link with hreflang), so the
  // Accept-Language redirect in vercel.json stops overriding it.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a[hreflang]');
    const code = a?.getAttribute('hreflang')?.split('-')[0];
    if (code) document.cookie = `lang=${code}; path=/; max-age=31536000; samesite=lax`;
  });
  // Close any open dropdown when clicking elsewhere or pressing Escape.
  const closeAll = (except?: Element | null) => {
    document.querySelectorAll('header details[open]').forEach((d) => {
      if (d !== except) d.removeAttribute('open');
    });
  };
  document.addEventListener('click', (e) => {
    const inside = (e.target as Element).closest('header details');
    closeAll(inside);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
