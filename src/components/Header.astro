---
// The top bar is the newsletter sign-up, with the logo as the way home. Menu,
// languages and the theme toggle live in the footer.
import { type Lang, route, t } from '@/i18n';
import Fields from '@/components/NewsletterFields.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const logo = 'shrink-0 font-mono text-sm font-semibold tracking-tight';
const linkClass = 'underline decoration-line underline-offset-4 hover:text-accent';
---

<header class="border-t-2 border-t-accent border-b border-b-line bg-accent-soft/60" aria-label={tr('newsletter.title')}>
  {/* Phones: one line; the button unfolds the field (details/summary, no JavaScript). */}
  <details class="group container-page md:hidden">
    <summary class="flex h-14 cursor-pointer list-none items-center gap-3 [&::-webkit-details-marker]:hidden">
      <a href={route('home', lang)} class={logo} aria-label={tr('nav.home')} dir="ltr">
        example<span class="text-accent">.com</span>
      </a>
      <span class="min-w-0 flex-1 truncate text-end text-xs font-semibold max-[359px]:hidden">{tr('newsletter.title')}</span>
      <span class="btn btn-primary ms-auto shrink-0 px-4 py-1.5 group-open:hidden">{tr('newsletter.submit')}</span>
      <span class="ms-auto hidden px-2 text-lg leading-none text-muted group-open:inline" aria-hidden="true">×</span>
    </summary>
    <div class="pb-3">
      <Fields lang={lang} id="newsletter-m" />
      <p class="mt-2 text-xs text-muted">{tr('newsletter.note')} <a href={route('privacy', lang)} class={linkClass}>{tr('nav.privacy')}</a></p>
    </div>
  </details>
  {/* Wider screens: logo, pitch and form on one line. */}
  <div class="container-page hidden h-16 items-center gap-6 md:flex">
    <a href={route('home', lang)} class={logo} aria-label={tr('nav.home')} dir="ltr">
      example<span class="text-accent">.com</span>
    </a>
    <p class="min-w-0 flex-1 text-sm">
      <span class="font-semibold">{tr('newsletter.title')}</span>
      <span class="hidden text-muted lg:inline"> · {tr('newsletter.note')} <a href={route('privacy', lang)} class={linkClass}>{tr('nav.privacy')}</a></span>
    </p>
    <div class="w-[24rem] shrink-0">
      <Fields lang={lang} id="newsletter-d" />
    </div>
  </div>
</header>
