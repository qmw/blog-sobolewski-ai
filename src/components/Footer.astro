---
import { type Lang, route, navOrder, t, pick, rssUrl, langs, languages } from '@/i18n';
import { profile, publicSocials } from '@/data/profile';

interface Props {
  lang: Lang;
  /** Path of this page in each language, so the language list keeps the visitor on the same page. */
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-4">
      <a href={route('home', lang)} class="font-mono text-sm font-semibold" dir="ltr">example<span class="text-accent">.com</span></a>
      <p class="max-w-sm text-sm text-muted text-pretty">{pick(profile.intro, lang)}</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          publicSocials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank" class="text-muted hover:text-accent">
                {s.name} ↗
              </a>
            </li>
          ))
        }
        <li><a href={rssUrl(lang)} class="text-muted hover:text-accent">{tr('blog.rss')}</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">{tr('nav.menu')}</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={route('home', lang)} class="text-muted hover:text-accent">{tr('nav.home')}</a></li>
        {navOrder.map((k) => <li><a href={route(k, lang)} class="text-muted hover:text-accent">{tr(`nav.${k}`)}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow">{tr('nav.language')}</p>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        {
          langs.map((l) => (
            <li>
              <a
                href={alternates[l] ?? route('home', l)}
                hreflang={languages[l].hreflang}
                lang={languages[l].hreflang}
                dir={languages[l].dir}
                class:list={['hover:text-accent', l === lang ? 'text-fg' : 'text-muted']}
                aria-current={l === lang ? 'true' : undefined}
              >
                {languages[l].name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container-page flex flex-col gap-2 border-t border-line py-6 text-xs text-muted sm:flex-row sm:justify-between">
    <p>
      © {year} {profile.name}. {tr('footer.rights')} ·
      <a href={profile.openSource} rel="noopener" target="_blank" class="hover:text-accent">{tr('footer.oss')} ↗</a>
    </p>
    <p class="flex items-center gap-3">
      <span><a href={route('privacy', lang)} class="hover:text-accent">{tr('nav.privacy')}</a> · {tr('footer.ai')} · {tr('footer.made')}</span>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-full border border-line p-1.5 text-muted hover:border-accent hover:text-accent"
        aria-label={tr('theme.toggle')}
      >
        <svg class="hidden size-3.5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="size-3.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </p>
  </div>
</footer>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
  // Remember an explicit language choice (any link with hreflang), so the
  // Accept-Language redirect in vercel.json stops overriding it.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a[hreflang]');
    const code = a?.getAttribute('hreflang')?.split('-')[0];
    if (code) document.cookie = `lang=${code}; path=/; max-age=31536000; samesite=lax`;
  });
</script>
